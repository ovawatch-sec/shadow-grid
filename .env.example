# ─────────────────────────────────────────────────────────────────────────────
#  ShadowGrid — local credential file
# ─────────────────────────────────────────────────────────────────────────────
#  The Docker image takes API keys from the Settings UI (stored in SQLite) or
#  from container environment variables. The CLI (`python3 recon.py`) has
#  neither, so it reads this file instead.
#
#  Setup:
#      cp .env.example .env
#      chmod 600 .env            # these are real credentials
#      # fill in only the keys you have — blank entries are ignored
#
#  Verify what got loaded (values are never printed):
#      python3 recon.py --show-config
#      python3 recon.py --list-tools
#
#  Search order — the first file that exists wins:
#      1. --env-file /path/to/file
#      2. $SHADOWGRID_ENV_FILE
#      3. ./.env                      (current directory)
#      4. <repo root>/.env
#      5. ~/.config/shadowgrid/.env   (shared by every working directory)
#
#  Precedence — highest first:
#      1. Variables already exported in your shell
#         (SHODAN_API_KEY=xxx python3 recon.py -d example.com)
#      2. This file
#      3. Keys saved in the database through the Settings UI
#
#  Syntax: KEY=value, one per line. `#` starts a comment. Quote values that
#  contain spaces or `#`. A leading `export ` is accepted. Multi-line values
#  are not supported.
#
#  NEVER commit the filled-in .env — .gitignore excludes it. Every tool below
#  is optional: a missing key only means that tool is cleanly skipped.
# ─────────────────────────────────────────────────────────────────────────────


# ── Recon / provider APIs ────────────────────────────────────────────────────

# ProjectDiscovery Cloud (https://cloud.projectdiscovery.io)
# Required by: asnmap. Without it asnmap is skipped — it cannot run
# non-interactively. Also used by ProjectDiscovery binaries that read it.
PDCP_API_KEY=

# GitHub personal access token (classic, no scopes needed for public data).
# Exported for external binaries that query the GitHub API (subfinder and
# amass provider configs). Raises their rate limits; nothing in ShadowGrid
# reads it directly.
GITHUB_TOKEN=

# Shodan (https://account.shodan.io)
# Required by: shodan. The tool runs only when selected for an assessment and
# filtered searches consume query credits.
SHODAN_API_KEY=

# Censys (https://search.censys.io/account/api)
# Exported for external binaries with Censys providers configured.
CENSYS_API_ID=
CENSYS_API_SECRET=

# ProjectDiscovery Chaos dataset (https://chaos.projectdiscovery.io)
# Exported for external binaries with a Chaos provider configured.
CHAOS_KEY=

# WPScan WordPress Vulnerability Database (https://wpscan.com/api)
# Optional for: wpscan. Without it wpscan still runs its built-in checks but
# returns no CVE-level vulnerability data. Free tier: 25 requests/day.
WPSCAN_API_TOKEN=

# SerpApi (https://serpapi.com/manage-api-key)
# Optional for: google_dorks. Without it dorking falls back to DuckDuckGo.
SERPAPI_API_KEY=

# Hunter (https://hunter.io/api-keys)
# Required by: email_finder. Without it email discovery is skipped. Email
# verification is opt-in per assessment and consumes extra Hunter credits.
HUNTER_API_KEY=


# ── AI analysis providers ────────────────────────────────────────────────────
# The ai_analysis tool needs exactly one of these. They are tried in the order
# listed below, so set only the provider you want to pay for.

# OpenAI — https://platform.openai.com/api-keys  (model: gpt-4o-mini)
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI / Gemini — https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys  (model: deepseek-chat)
DEEPSEEK_API_KEY=

# Groq — https://console.groq.com/keys  (model: llama-3.1-8b-instant)
GROQ_API_KEY=


# ── Backend server settings (not used by the CLI) ────────────────────────────
# Read by backend/config.py when you run the API directly
# (`cd backend && python3 -m uvicorn main:app`). The CLI takes these from
# --output-dir / --data-dir instead, and Docker sets them in docker-compose.yml.
# Uncomment to override the defaults.

# HOST=0.0.0.0
# PORT=8000
# DEBUG=false
# Comma-separated allowlist. Leave unset for "*" — set it for any deployment
# reachable beyond localhost.
# CORS_ORIGINS=http://localhost:4200
# OUTPUT_DIR=./output
# DATA_DIR=./data
# DATABASE_DIR=./data/database
